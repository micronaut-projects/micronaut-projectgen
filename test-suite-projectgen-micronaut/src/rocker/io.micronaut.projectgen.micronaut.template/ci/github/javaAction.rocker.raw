@import io.micronaut.projectgen.core.generator.Project
@import io.micronaut.projectgen.core.options.JdkDistribution
@import io.micronaut.projectgen.core.options.JdkVersion
@import io.micronaut.projectgen.core.buildtools.BuildTool
@args (
JdkVersion jdkVersion,
JdkDistribution jdkDistribution,
BuildTool buildTool,
String branch
)
name: Java CI with @buildTool.getTitle()

on:
  push:
    branches: [ @branch ]
  pull_request:
    branches: [ @branch ]

@if (buildTool == BuildTool.GRADLE) {
permissions:
  contents: read
}

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
    - uses: actions/checkout@@v4.2.2 # https://github.com/actions/checkout
    - name: Set up JDK @jdkVersion.majorVersion()
      uses: actions/setup-java@@v3.14.1 # https://github.com/actions/setup-java
      with:
        java-version: @jdkVersion.majorVersion()
        distribution: @jdkDistribution.distribution()
@if (buildTool.equals(BuildTool.MAVEN)) {
        cache: maven
    - name: Build with Maven
      run: mvn -B verify --file pom.xml
} else if (buildTool == BuildTool.GRADLE) {
    - name: Validate Gradle wrapper
      uses: gradle/actions/wrapper-validation@@v4.4.0 # https://github.com/gradle/actions/tree/main/wrapper-validation
    - name: Build with Gradle
      uses: gradle/actions/setup-gradle@@v4.4.0 # https://github.com/gradle/actions/tree/main/setup-gradle
      with:
        arguments: build
    - uses: actions/upload-artifact@@v4.6.2 # https://github.com/actions/upload-artifact
      with:
        name: Build Artifacts
        path: |
          **/build/reports
}
