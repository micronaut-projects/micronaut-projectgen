@option discardLogicWhitespace=true
@import io.micronaut.projectgen.core.generator.Project
@import io.micronaut.projectgen.core.buildtools.gradle.GradleBuild
@import io.micronaut.projectgen.core.buildtools.gradle.GradlePlugin
@import io.micronaut.projectgen.core.buildtools.gradle.GradleDependency
@args (Project project, GradleBuild gradleBuild, String mainClassName, String version, String groupId)
@if(gradleBuild.getPlugins().size() > 0) {
plugins {
@for (GradlePlugin gradlePlugin : gradleBuild.getPlugins()) {
@if(gradlePlugin.getAlias() != null) {
    alias(@gradlePlugin.getAlias())@(gradlePlugin.getApply() != null ? " apply false" : "")
} else {
    id("@gradlePlugin.getId()")@(gradlePlugin.getVersion() != null ? " version \"" + gradlePlugin.getVersion() + "\"" : "")@(gradlePlugin.getApply() != null ? " apply false" : "")
}
}
}
}
@if (gradleBuild.coordinate() != null && gradleBuild.coordinate().getGroupId() != null) {
group = "@(gradleBuild.coordinate().getGroupId())"
}
@if (gradleBuild.coordinate() != null && gradleBuild.coordinate().getVersion() != null) {
version = "@(gradleBuild.coordinate().getVersion())"
}
@if(gradleBuild.repositories().size() > 0) {
repositories {
@gradleBuild.renderRepositories()
}
}
@if(gradleBuild.dependencies().size() > 0) {
dependencies {
@for (GradleDependency dependency : gradleBuild.dependencies()) {
    @dependency.toSnippet()
}
}
}
@if (mainClassName != null) {
application {
    mainClass = "@(project.getPackageName()).@mainClassName"
}
}
@gradleBuild.renderExtensions()
